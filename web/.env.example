# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only Supabase secret key for server-authority workflow writes.
# Use the current Supabase `sb_secret_...` secret key. Keep it server-only and never prefix it with NEXT_PUBLIC_.
# Required for source setup mutations because workflow table RLS is select-only for authenticated clients.
SUPABASE_SECRET_KEY=

# Temporary local fallback for older projects only. Prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI/GEO service settings. Do not expose these to the browser.
AI_SERVICE_URL=
AI_SERVICE_SECRET=

# Server-only Shopify settings for the connected-store flow.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,write_products
SHOPIFY_APP_URL=https://amount-dallying-approve.ngrok-free.dev
SHOPIFY_REDIRECT_URI=https://amount-dallying-approve.ngrok-free.dev/api/shopify/callback
SHOPIFY_API_VERSION=2026-04

# Generate once with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep stable; changing it requires reconnecting stores because old encrypted tokens cannot be decrypted.
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# Optional local-development convenience only. Do not rely on this in production.
SHOPIFY_TEST_SHOP_DOMAIN=
