# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only Supabase key for server-authority workflow writes.
# Required for Phase 3 source setup mutations because workflow table RLS is select-only for authenticated clients.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI/GEO service settings. Do not expose these to the browser.
AI_SERVICE_URL=
AI_SERVICE_SECRET=

# Server-only Shopify settings for the connected-store flow.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_APP_URL=
